#!/usr/bin/env bash
# gstack-register-test - upstream gstack skill discovery and the user exclude list.

# Sources the imported registration modules from this repository and points
# them at fixture directories instead of the real gstack checkout.
# shellcheck disable=SC1090,SC1091,SC2034

set -o pipefail
export NO_COLOR=1

repo_root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P) || exit 1
# shellcheck source=lib/test.sh
. "$repo_root/test/lib/test.sh"

work=$(_tmpdir)
lib="$repo_root/lib/gstack-register"

# shellcheck source=../gstack-register/paths.sh
. "$lib/paths.sh"
# shellcheck source=../gstack-register/source.sh
. "$lib/source.sh"
# shellcheck source=../gstack-register/managed.sh
. "$lib/managed.sh"

gstack_dir="$work/gstack"
mkdir -p "$gstack_dir"

# Upstream ships each skill as a directory with a SKILL.md whose name field
# matches the directory. Mirror that shape, plus the non-skill directories the
# scanner has always skipped.
for name in browse qa ios-qa ios-fix ship diagram; do
  mkdir -p "$gstack_dir/$name"
  printf -- '---\nname: %s\ndescription: fixture %s\n---\n' "$name" "$name" \
    >"$gstack_dir/$name/SKILL.md"
done
for name in node_modules browser-skills openclaw test; do
  mkdir -p "$gstack_dir/$name"
  printf -- '---\nname: %s\n---\n' "$name" >"$gstack_dir/$name/SKILL.md"
done
mkdir -p "$gstack_dir/not-a-skill"

_scan_names() {
  _gstack_register_reset_source_cache
  _gstack_register_each_source_skill "$gstack_dir" | while IFS= read -r dir; do
    basename "$dir"
  done | LC_ALL=C sort | tr '\n' ' '
}

# --- baseline: no exclude file -------------------------------------------
export GSTACK_REGISTER_SKILL_EXCLUDE_FILE="$work/absent-exclude-list"
_assert_eq "source scan: skips non-skill dirs when no exclude file exists" \
  "browse diagram ios-fix ios-qa qa ship " "$(_scan_names)"

# --- exclusions by bare and prefixed name --------------------------------
exclude="$work/exclude"
export GSTACK_REGISTER_SKILL_EXCLUDE_FILE="$exclude"
cat >"$exclude" <<'EOF'
# Comment lines and blanks are ignored.
browse

gstack-ios-qa
  ios-fix
EOF
_assert_eq "exclude list: honors bare, gstack-prefixed, and indented names" \
  "diagram qa ship " "$(_scan_names)"

# --- trailing line without a newline -------------------------------------
printf 'browse\nqa' >"$exclude"
_assert_eq "exclude list: applies a final line with no trailing newline" \
  "diagram ios-fix ios-qa ship " "$(_scan_names)"

# --- inline comment on an entry ------------------------------------------
printf 'browse # not used on this host\n' >"$exclude"
_assert_eq "exclude list: strips inline comments from an entry" \
  "diagram ios-fix ios-qa qa ship " "$(_scan_names)"

# --- empty and comment-only files are no-ops ------------------------------
printf '# nothing excluded\n\n' >"$exclude"
_assert_eq "exclude list: comment-only file excludes nothing" \
  "browse diagram ios-fix ios-qa qa ship " "$(_scan_names)"

# --- built-in skips cannot be re-enabled ----------------------------------
printf '\n' >"$exclude"
_assert_not_contains "source scan: node_modules is never a skill" "node_modules" "$(_scan_names)"
_assert_not_contains "source scan: dirs without SKILL.md are ignored" "not-a-skill" "$(_scan_names)"

# --- unmatched entries warn instead of failing open silently --------------
printf 'gstack-typo-here\nbrowse\n' >"$exclude"
_gstack_register_reset_source_cache
warn_output=$(_gstack_register_load_source_skills "$gstack_dir" 2>&1 >/dev/null)
_assert_contains "exclude list: warns about an entry matching no upstream skill" \
  "gstack-typo-here" "$warn_output"
_assert_not_contains "exclude list: does not warn about an entry that matched" \
  "gstack-browse" "$warn_output"

# A typo must not drop unrelated skills.
_assert_eq "exclude list: a typo leaves other skills registered" \
  "diagram ios-fix ios-qa qa ship " "$(_scan_names)"

# --- the loaded inventory reflects exclusions -----------------------------
printf 'browse\nqa\n' >"$exclude"
_gstack_register_reset_source_cache
_gstack_register_load_source_skills "$gstack_dir" 2>/dev/null
_assert_eq "source inventory: excluded skills are absent from the name index" \
  "" "${_GSTACK_REGISTER_SOURCE_CODEX_NAME_EXISTS["gstack-browse"]+present}"
_assert_eq "source inventory: retained skills stay in the name index" \
  "present" "${_GSTACK_REGISTER_SOURCE_CODEX_NAME_EXISTS["gstack-ship"]+present}"

# The cache fingerprint must move when the list changes, or a warm sync
# would keep serving the pre-edit registration set.
# shellcheck source=../gstack-register/managed.sh
. "$lib/managed.sh" 2>/dev/null || true
# shellcheck source=../gstack-register/cache.sh
. "$lib/cache.sh"
_gstack_register_reset_source_cache
before=$(_gstack_register_source_fingerprint "$gstack_dir")
printf 'browse\n' >"$exclude"
_gstack_register_reset_source_cache
after=$(_gstack_register_source_fingerprint "$gstack_dir")
if [ "$before" != "$after" ]; then
  _pass "cache: source fingerprint changes when the exclude list changes"
else
  _fail "cache: source fingerprint changes when the exclude list changes"
fi

# Keep the copyable policy file on the same parser path as real configuration.
# Synthetic names make this safe for a public repository while still proving
# comments and the accepted prefixed spelling remain valid.
example_gstack_dir="$work/example-gstack"
for name in example-skill another-example retained-example; do
  mkdir -p "$example_gstack_dir/$name"
  printf -- '---\nname: %s\ndescription: example fixture\n---\n' "$name" \
    >"$example_gstack_dir/$name/SKILL.md"
done
export GSTACK_REGISTER_SKILL_EXCLUDE_FILE="$repo_root/examples/skills-exclude"
_gstack_register_reset_source_cache
example_names=$(
  _gstack_register_each_source_skill "$example_gstack_dir" |
    while IFS= read -r dir; do basename "$dir"; done |
    LC_ALL=C sort | tr '\n' ' '
)
_assert_eq "examples: checked-in exclusion policy is accepted by the real parser" \
  "retained-example " "$example_names"

# Portable byte-equality: identical files compare equal, differing or missing
# files do not. The no-cmp fallback path (cksum) is covered by CI on minimal
# images (Arch/Fedora/RHEL families ship no diffutils); here we pin the
# contract on the cmp path.
printf 'same-bytes' >"$work/eq-a"
printf 'same-bytes' >"$work/eq-b"
printf 'other-bytes' >"$work/diff-b"
if _gstack_register_files_equal "$work/eq-a" "$work/eq-b"; then
  _pass "files_equal: identical files compare equal"
else
  _fail "files_equal: identical files compare equal"
fi
if _gstack_register_files_equal "$work/eq-a" "$work/diff-b"; then
  _fail "files_equal: differing files compare unequal"
else
  _pass "files_equal: differing files compare unequal"
fi
if _gstack_register_files_equal "$work/eq-a" "$work/absent"; then
  _fail "files_equal: missing file never compares equal"
else
  _pass "files_equal: missing file never compares equal"
fi

_test_summary
