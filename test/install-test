#!/usr/bin/env bash
# Installer symlink safety and idempotence.

set -o pipefail

repo_root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P) || exit 1
# shellcheck source=lib/test.sh
. "$repo_root/test/lib/test.sh"

# macOS commonly exposes TMPDIR through /var with a trailing slash while
# pwd -P resolves the same directory below /private/var. Build every fixture
# path from the physical root so the managed-checkout input is normalized.
work=$(_tmpdir)
work=$(cd -P -- "$work" && pwd -P)
prefix="$work/prefix"
wrapper="$repo_root/install.sh"
delegate="$repo_root/support/install-checkout.sh"

_assert_file_exists "installer: generated checkout wrapper is present" "$wrapper"
_assert_file_exists "installer: checkout-owned delegate is present" "$delegate"
_assert_contains "installer: wrapper identifies the shared generator" \
  "Generated by cgraf78/actions checkout-installer" \
  "$(sed -n '2p' "$wrapper")"
if [[ ! -f "$wrapper" || ! -f "$delegate" ]]; then
  _test_summary
fi

install_status=0
PREFIX="$prefix" "$wrapper" >"$work/install.out" 2>"$work/install.err" ||
  install_status=$?
_assert_exit "installer: direct checkout succeeds" 0 "$install_status"
target="$prefix/bin/gstack-register"
if [[ -L "$target" ]]; then
  _pass "installer: creates a command symlink"
else
  _fail "installer: creates a command symlink"
fi
_assert_eq "installer: points at this checkout" \
  "$repo_root/bin/gstack-register" "$(readlink "$target")"
runtime_status=0
runtime_output=$("$target" --help 2>&1) || runtime_status=$?
_assert_exit "installer: installed command exits successfully" 0 "$runtime_status"
_assert_contains "installer: installed command resolves checkout libraries" \
  "Usage: gstack-register" "$runtime_output"

PREFIX="$prefix" "$wrapper" >"$work/reinstall.out"
_assert_exit "installer: reinstall is idempotent" 0 "$?"

custom_bin="$work/custom-bin"
BIN_DIR="$custom_bin" "$delegate" >"$work/custom.out"
if [[ -L "$custom_bin/gstack-register" ]]; then
  _pass "installer: honors BIN_DIR"
else
  _fail "installer: honors BIN_DIR"
fi

blocked="$work/blocked"
mkdir -p "$blocked"
printf 'owned elsewhere\n' >"$blocked/gstack-register"
set +e
BIN_DIR="$blocked" "$delegate" \
  >"$work/blocked.out" 2>"$work/blocked.err"
status=$?
set -e
_assert_exit "installer: refuses a non-symlink target" 1 "$status"
_assert_file_content "installer: preserves a non-symlink target" \
  "owned elsewhere" "$blocked/gstack-register"
_assert_contains "installer: refusal is actionable" \
  "refusing to replace non-symlink" "$(cat "$work/blocked.err")"

missing_root="$work/missing-source"
missing_prefix="$work/missing-prefix"
mkdir -p "$missing_root/support"
cp "$delegate" "$missing_root/support/install-checkout.sh"
set +e
PREFIX="$missing_prefix" "$missing_root/support/install-checkout.sh" \
  >"$work/missing.out" 2>"$work/missing.err"
status=$?
set -e
_assert_exit "installer: rejects a missing command source" 1 "$status"
if [[ ! -e "$missing_prefix/bin/gstack-register" &&
  ! -L "$missing_prefix/bin/gstack-register" ]]; then
  _pass "installer: missing source publishes no command"
else
  _fail "installer: missing source publishes no command"
fi
_assert_contains "installer: missing source is actionable" \
  "command source is not executable" "$(cat "$work/missing.err")"

curl_source="$work/curl-source"
curl_remote="$work/gstack-register.git"
curl_checkout="$work/managed/gstack-register"
curl_prefix="$work/curl-prefix"
mkdir -p "$curl_source"
cp "$wrapper" "$curl_source/install.sh"
cp -R "$repo_root/bin" "$repo_root/lib" "$repo_root/support" \
  "$curl_source/"
git -C "$curl_source" init --quiet --initial-branch=main --template=''
git -C "$curl_source" config core.hooksPath /dev/null
git -C "$curl_source" config commit.gpgsign false
git -C "$curl_source" config user.name 'Gstack Register Installer Test'
git -C "$curl_source" config user.email \
  gstack-register-installer@example.invalid
git -C "$curl_source" add .
git -C "$curl_source" commit --quiet -m 'checkout installer fixture'
git init --quiet --bare --initial-branch=main "$curl_remote"
git -C "$curl_source" remote add origin "$curl_remote"
git -C "$curl_source" push --quiet --set-upstream origin main

direct_prefix="$work/direct-prefix"
set +e
PREFIX="$direct_prefix" "$curl_source/install.sh" >/dev/null 2>&1
direct_install_status=$?
set -e
_assert_exit "installer: direct fixture checkout succeeds" \
  0 "$direct_install_status"
# macOS exposes TMPDIR below /var while pwd -P resolves it below /private/var.
# The installer deliberately publishes the physical checkout target.
direct_source_physical=$(cd -P -- "$curl_source" && pwd -P)
_assert_eq "installer: direct wrapper selects its physical checkout" \
  "$direct_source_physical/bin/gstack-register" \
  "$(readlink "$direct_prefix/bin/gstack-register")"
direct_runtime_status=0
direct_runtime_output=$("$direct_prefix/bin/gstack-register" --help 2>&1) ||
  direct_runtime_status=$?
_assert_exit "installer: direct fixture command exits successfully" \
  0 "$direct_runtime_status"
_assert_contains "installer: direct wrapper publishes a working command" \
  "Usage: gstack-register" "$direct_runtime_output"

curl_output_file="$work/curl.out"
set +e
curl --fail --silent --show-error "file://$wrapper" |
  PREFIX="$curl_prefix" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$curl_checkout" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$curl_remote" \
    bash -s >"$curl_output_file" 2>&1
curl_pipeline_status=("${PIPESTATUS[@]}")
set -e
_assert_exit "installer: curl transport succeeds" \
  0 "${curl_pipeline_status[0]}"
_assert_exit "installer: managed checkout succeeds" \
  0 "${curl_pipeline_status[1]}"
curl_output=$(<"$curl_output_file")
curl_checkout_physical=$(cd -P -- "$curl_checkout" && pwd -P)
_assert_file_exists "installer: curl bootstrap keeps a durable checkout" \
  "$curl_checkout/.git/HEAD"
_assert_eq "installer: curl command selects the managed checkout" \
  "$curl_checkout_physical/bin/gstack-register" \
  "$(readlink "$curl_prefix/bin/gstack-register")"
curl_runtime_status=0
curl_runtime_output=$("$curl_prefix/bin/gstack-register" --help 2>&1) ||
  curl_runtime_status=$?
_assert_exit "installer: managed command exits successfully" \
  0 "$curl_runtime_status"
_assert_contains "installer: curl bootstrap publishes a working command" \
  "Usage: gstack-register" "$curl_runtime_output"
_assert_contains "installer: curl bootstrap reports its durable clone" \
  "cloning cgraf78/gstack-register to $curl_checkout_physical" "$curl_output"

_test_summary
