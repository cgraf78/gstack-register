_assert_file_exists "gstack: sync creates shared generated skill" \
  "$_gstack_home/.local/share/gstack-register/skills/gstack-qa/SKILL.md"
_assert_file_exists "gstack: sync creates shared Gemini context" \
  "$_gstack_home/.local/share/gstack-register/skills/GEMINI.md"
_assert_file_exists "gstack: sync marks shared generated skill as managed" \
  "$_gstack_home/.local/share/gstack-register/skills/gstack-qa/.gstack-register-managed"
_assert_file_exists "gstack: sync links prefixed Claude skill" \
  "$_gstack_home/.claude/skills/gstack-qa/SKILL.md"
_assert_eq "gstack: sync points Claude skill at shared generated skill" \
  "$_gstack_home/.local/share/gstack-register/skills/gstack-qa" \
  "$(readlink "$_gstack_home/.claude/skills/gstack-qa")"
_assert_file_missing "gstack: sync removes legacy unprefixed Claude skill" \
  "$_gstack_home/.claude/skills/qa/SKILL.md"
_assert_contains "gstack: sync preserves unmanaged Claude skill collision" \
  "name: manual-owned" "$(cat "$_gstack_home/.claude/skills/manual/SKILL.md")"
_assert_file_missing "gstack: sync prunes stale Claude gstack link" \
  "$_gstack_home/.claude/skills/checkpoint"
_assert_file_missing "gstack: sync prunes legacy unprefixed Codex copy" \
  "$_gstack_home/.codex/skills/qa/SKILL.md"
_assert_file_exists "gstack: sync preserves unmanaged Codex skill with prose marker" \
  "$_gstack_home/.codex/skills/review/SKILL.md"
_assert_file_missing "gstack: sync prunes removed-source legacy Codex copy" \
  "$_gstack_home/.codex/skills/removed/SKILL.md"
_assert_file_missing "gstack: sync prunes stale managed Codex skill" \
  "$_gstack_home/.codex/skills/gstack-old/SKILL.md"
_assert_file_exists "gstack: sync links Codex source skill" \
  "$_gstack_home/.codex/skills/gstack-qa/SKILL.md"
_assert_eq "gstack: sync points Codex skill at shared generated skill" \
  "$_gstack_home/.local/share/gstack-register/skills/gstack-qa" \
  "$(readlink "$_gstack_home/.codex/skills/gstack-qa")"
_assert_file_exists "gstack: sync marks Codex source skill as managed" \
  "$_gstack_home/.codex/skills/gstack-qa/.gstack-register-managed"
_assert_file_missing "gstack: sync removes legacy Codex runtime root" \
  "$_gstack_home/.codex/skills/gstack/SKILL.md"
_assert_contains "gstack: sync rewrites Codex skill name" \
  "name: gstack-qa" "$(cat "$_gstack_home/.codex/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: sync quotes invalid Codex YAML descriptions" \
  'description: "QA workflow: catches visual regressions. (gstack)"' \
  "$(cat "$_gstack_home/.codex/skills/gstack-qa/SKILL.md")"
_assert_eq "gstack: Muse skills resolve below the config home" \
  "$_gstack_home/.config/muse/skills" "$(_gstack_register_muse_skills_dir)"
_assert_contains "gstack: sync installs Muse skill through the CLI" \
  "install --force $_gstack_home/.local/share/gstack-register/skills/gstack-qa" \
  "$(cat "$_gstack_muse_log")"
_assert_file_exists "gstack: sync installs Muse source skill" \
  "$_gstack_home/.config/muse/skills/gstack-qa/SKILL.md"
_assert_file_exists "gstack: sync marks Muse source skill as managed" \
  "$_gstack_home/.config/muse/skills/gstack-qa/.gstack-register-managed"
_assert_eq "gstack: sync installs current Muse skill content" \
  "$(cat "$_gstack_home/.local/share/gstack-register/skills/gstack-qa/SKILL.md")" \
  "$(cat "$_gstack_home/.config/muse/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: sync rewrites absolute Claude runtime paths" \
  "Run $_gstack_repo/bin/gstack-config" \
  "$(cat "$_gstack_home/.local/share/gstack-register/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: sync preserves project-relative vendored checks" \
  ".claude/skills/gstack vendored checks local" \
  "$(cat "$_gstack_home/.local/share/gstack-register/skills/gstack-qa/SKILL.md")"
_assert_file_exists "gstack: sync creates Gemini extension manifest" \
  "$_gstack_home/.gemini/extensions/gstack/gemini-extension.json"
_assert_file_exists "gstack: sync marks Gemini extension as managed" \
  "$_gstack_home/.gemini/extensions/gstack/.gstack-register-managed"
_assert_eq "gstack: sync points Gemini context at shared generated context" \
  "$_gstack_home/.local/share/gstack-register/skills/GEMINI.md" \
  "$(readlink "$_gstack_home/.gemini/extensions/gstack/GEMINI.md")"
_assert_contains "gstack: generated Gemini context references prefixed skills" \
  "generated \`gstack-*\` agent" \
  "$(cat "$_gstack_home/.local/share/gstack-register/skills/GEMINI.md")"
# shellcheck disable=SC2088  # This assertion intentionally checks literal upstream prose.
_assert_not_contains "gstack: generated Gemini context avoids raw Claude runtime paths" \
  '~/.claude/skills/gstack' \
  "$(cat "$_gstack_home/.local/share/gstack-register/skills/GEMINI.md")"
_assert_file_exists "gstack: sync links Gemini source skill" \
  "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa/SKILL.md"
_assert_eq "gstack: sync points Gemini skill at shared generated skill" \
  "$_gstack_home/.local/share/gstack-register/skills/gstack-qa" \
  "$(readlink "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa")"
_assert_file_exists "gstack: sync marks Gemini source skill as managed" \
  "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa/.gstack-register-managed"
_assert_contains "gstack: sync rewrites Gemini skill name" \
  "name: gstack-qa" "$(cat "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: sync quotes invalid Gemini YAML descriptions" \
  'description: "QA workflow: catches visual regressions. (gstack)"' \
  "$(cat "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: sync leaves upstream source skill unchanged" \
  "description: QA workflow: catches visual regressions. (gstack)" \
  "$(cat "$_gstack_repo/qa/SKILL.md")"
_assert_file_missing "gstack: sync skips node_modules skills" \
  "$_gstack_home/.claude/skills/gstack-ignored/SKILL.md"
_assert_file_missing "gstack: sync skips node_modules generated cache" \
  "$_gstack_home/.local/share/gstack-register/skills/gstack-ignored/SKILL.md"
_assert_file_exists "gstack: sync stamps install-shape migration" \
  "$_gstack_home/.local/state/gstack-register/legacy-dotfiles-v1"
if [[ -d "$_gstack_home/.gstack" && ! -L "$_gstack_home/.gstack" ]]; then
  _pass "gstack: sync uses real state directory"
else
  _fail "gstack: sync uses real state directory"
fi

# Warm re-arming is a convergence optimization. The standalone provider owns
# its scratch allocator, so this exercises the same path without dot internals.

eval "$(declare -f _gstack_register_claude |
  sed '1s/_gstack_register_claude/_orig_gstack_register_claude/')"
eval "$(declare -f _gstack_register_codex |
  sed '1s/_gstack_register_codex/_orig_gstack_register_codex/')"
eval "$(declare -f _gstack_register_gemini |
  sed '1s/_gstack_register_gemini/_orig_gstack_register_gemini/')"
eval "$(declare -f _gstack_register_source_fingerprint |
  sed '1s/_gstack_register_source_fingerprint/_orig_gstack_register_source_fingerprint/')"
eval "$(declare -f _gstack_register_target_fingerprint |
  sed '1s/_gstack_register_target_fingerprint/_orig_gstack_register_target_fingerprint/')"
_gstack_full_register_log=$(_tmpdir)/gstack-full-register.log
_gstack_fingerprint_log=$(_tmpdir)/gstack-fingerprint.log
_gstack_fingerprint_race_marker=$(_tmpdir)/gstack-fingerprint-race
: >"$_gstack_full_register_log"
: >"$_gstack_fingerprint_log"

_gstack_touch_newer_than() {
  local path="$1" reference="$2" deadline=$((SECONDS + 3))

  while [[ ! "$path" -nt "$reference" ]]; do
    touch "$path"
    [[ "$path" -nt "$reference" ]] && return 0
    ((SECONDS < deadline)) || return 1
    sleep 0.05
  done
}
# shellcheck disable=SC2329  # gstack_register_sync invokes this by name.
_gstack_register_claude() {
  printf 'claude\n' >>"$_gstack_full_register_log"
  _orig_gstack_register_claude "$@"
}
# shellcheck disable=SC2329  # gstack_register_sync invokes this by name.
_gstack_register_codex() {
  printf 'codex\n' >>"$_gstack_full_register_log"
  _orig_gstack_register_codex "$@"
}
# shellcheck disable=SC2329  # gstack_register_sync invokes this by name.
_gstack_register_gemini() {
  printf 'gemini\n' >>"$_gstack_full_register_log"
  _orig_gstack_register_gemini "$@"
}
# shellcheck disable=SC2329  # gstack_register_sync invokes this by name.
_gstack_register_source_fingerprint() {
  local fence
  printf 'source\n' >>"$_gstack_fingerprint_log"
  if [[ -f "$_gstack_fingerprint_race_marker" ]]; then
    rm -f "$_gstack_fingerprint_race_marker"
    # The production code creates this validation-start fence immediately
    # before invoking the fingerprint. Move a watched parent strictly after it
    # to model a concurrent mutation without relying on clock resolution. The
    # glob deliberately mirrors cache.sh's allocator template; divergence fails
    # the later "forces one more proof" assertion rather than weakening it.
    for fence in "$_gstack_home/.cache/gstack-register/registration-v1.rearm.tmp."*; do
      [[ -f "$fence" ]] || continue
      _gstack_touch_newer_than "$_gstack_home/.claude/skills" "$fence" || return 1
      break
    done
  fi
  _orig_gstack_register_source_fingerprint "$@"
}
# shellcheck disable=SC2329  # gstack_register_sync invokes this by name.
_gstack_register_target_fingerprint() {
  printf 'target\n' >>"$_gstack_fingerprint_log"
  _orig_gstack_register_target_fingerprint "$@"
}

if gstack_register_sync; then
  _pass "gstack: current registration cache check succeeds"
else
  _fail "gstack: current registration cache check succeeds"
fi
_assert_eq "gstack: current registration skips full rewrite path" \
  "" "$(cat "$_gstack_full_register_log")"
_assert_eq "gstack: current registration skips fingerprint scans" \
  "" "$(cat "$_gstack_fingerprint_log")"

# A parent-directory mtime change can conservatively invalidate the watch fast
# path even when the source and every managed target are still byte-for-byte
# current. The first call must do the full fingerprint proof. Once that proof
# succeeds, the cache should be re-armed so every later warm update does not
# repeat the same expensive scan indefinitely.
if _gstack_touch_newer_than \
  "$_gstack_home/.claude/skills" \
  "$_gstack_home/.cache/gstack-register/registration-v1"; then
  _pass "gstack: test invalidation is newer than the cache"
else
  _fail "gstack: test invalidation is newer than the cache"
fi
: >"$_gstack_full_register_log"
: >"$_gstack_fingerprint_log"
if gstack_register_sync; then
  _pass "gstack: unchanged parent mtime invalidation validates successfully"
else
  _fail "gstack: unchanged parent mtime invalidation validates successfully"
fi
_assert_eq "gstack: unchanged parent mtime does not rewrite registrations" \
  "" "$(cat "$_gstack_full_register_log")"
_assert_contains "gstack: unchanged parent mtime performs one fingerprint proof" \
  "source" "$(cat "$_gstack_fingerprint_log")"
: >"$_gstack_fingerprint_log"
if gstack_register_sync; then
  _pass "gstack: validated parent mtime re-arms the watch cache"
else
  _fail "gstack: validated parent mtime re-arms the watch cache"
fi
_assert_eq "gstack: re-armed watch cache skips repeated fingerprint scans" \
  "" "$(cat "$_gstack_fingerprint_log")"

# A mutation during fingerprint validation must not be hidden by re-arming the
# cache to a later completion timestamp. The next call must validate again;
# only that race-free proof may restore the watch fast path.
if _gstack_touch_newer_than \
  "$_gstack_home/.claude/skills" \
  "$_gstack_home/.cache/gstack-register/registration-v1"; then
  _pass "gstack: race fixture starts with an invalidated cache"
else
  _fail "gstack: race fixture starts with an invalidated cache"
fi
: >"$_gstack_fingerprint_race_marker"
: >"$_gstack_fingerprint_log"
gstack_register_sync || _fail "gstack: concurrent invalidation validates successfully"
_assert_contains "gstack: concurrent invalidation performs fingerprint proof" \
  "source" "$(cat "$_gstack_fingerprint_log")"
: >"$_gstack_fingerprint_log"
gstack_register_sync || _fail "gstack: concurrent invalidation remains visible"
_assert_contains "gstack: concurrent invalidation forces one more proof" \
  "source" "$(cat "$_gstack_fingerprint_log")"
: >"$_gstack_fingerprint_log"
gstack_register_sync || _fail "gstack: race-free proof re-arms cache"
_assert_eq "gstack: race-free proof restores watch fast path" \
  "" "$(cat "$_gstack_fingerprint_log")"

# Interactive merge hooks execute the hook body in a nested Bash child. That
# child inherits the parent's registry variables but not its caught traps, so
# production must establish a child-owned cleanup context before allocating the
# fence. Verify that real execution shape still re-arms the parent-visible
# cache and leaves no sibling scratch behind.
if _gstack_touch_newer_than \
  "$_gstack_home/.claude/skills" \
  "$_gstack_home/.cache/gstack-register/registration-v1"; then
  _pass "gstack: nested hook fixture starts with an invalidated cache"
else
  _fail "gstack: nested hook fixture starts with an invalidated cache"
fi
: >"$_gstack_fingerprint_log"
(gstack_register_sync) || _fail "gstack: nested hook validation succeeds"
_assert_contains "gstack: nested hook performs fingerprint proof" \
  "source" "$(cat "$_gstack_fingerprint_log")"
: >"$_gstack_fingerprint_log"
gstack_register_sync || _fail "gstack: nested hook re-arms cache"
_assert_eq "gstack: nested hook restores watch fast path" \
  "" "$(cat "$_gstack_fingerprint_log")"
_gstack_rearm_scratch=''
for _gstack_rearm_candidate in \
  "$_gstack_home/.cache/gstack-register/registration-v1.rearm.tmp."*; do
  [[ -e "$_gstack_rearm_candidate" ]] || continue
  _gstack_rearm_scratch=$_gstack_rearm_candidate
  break
done
_assert_eq "gstack: nested hook removes re-arm scratch" "" "$_gstack_rearm_scratch"

ln -sfn "$_gstack_repo" "$_gstack_home/.claude/skills/gstack"
ln -sfn gstack/open-gstack-browser "$_gstack_home/.claude/skills/connect-chrome"
touch -r "$_gstack_home/.cache/gstack-register/registration-v1" "$_gstack_home/.claude/skills"
: >"$_gstack_full_register_log"
if gstack_register_sync; then
  _pass "gstack: cache miss repairs recreated Claude compatibility roots"
else
  _fail "gstack: cache miss repairs recreated Claude compatibility roots"
fi
_assert_contains "gstack: recreated Claude root forces repair" \
  "claude" "$(cat "$_gstack_full_register_log")"
_assert_file_missing "gstack: cache miss removes recreated Claude compatibility root" \
  "$_gstack_home/.claude/skills/gstack"
_assert_file_missing "gstack: cache miss removes recreated connect-chrome alias" \
  "$_gstack_home/.claude/skills/connect-chrome"

touch -t 200001010000.00 "$_gstack_home/.cache/gstack-register/registration-v1"
: >"$_gstack_full_register_log"
if gstack_register_sync; then
  _pass "gstack: target freshness check succeeds"
else
  _fail "gstack: target freshness check succeeds"
fi
_assert_contains "gstack: target newer than cache forces validation" \
  "codex" "$(cat "$_gstack_full_register_log")"

rm -f "$_gstack_home/.codex/skills/gstack-qa/SKILL.md"
: >"$_gstack_full_register_log"
if gstack_register_sync; then
  _pass "gstack: cache miss repairs missing generated skill"
else
  _fail "gstack: cache miss repairs missing generated skill"
fi
_assert_contains "gstack: missing generated skill forces Codex repair" \
  "codex" "$(cat "$_gstack_full_register_log")"
_assert_file_exists "gstack: cache miss restores missing generated skill" \
  "$_gstack_home/.codex/skills/gstack-qa/SKILL.md"

# Muse registrations are CLI-owned: reinstall drifted content, preserve
# unmanaged copies, restore missing skills, and skip current ones.
printf 'drifted Muse content\n' \
  >>"$_gstack_home/.config/muse/skills/gstack-qa/SKILL.md"
touch -t 200001010000.00 "$_gstack_home/.cache/gstack-register/registration-v1"
: >"$_gstack_muse_log"
if gstack_register_sync; then
  _pass "gstack: changed Muse skill reinstalls through the CLI"
else
  _fail "gstack: changed Muse skill reinstalls through the CLI"
fi
_assert_contains "gstack: changed Muse skill forces reinstall" \
  "install --force" "$(cat "$_gstack_muse_log")"
_assert_eq "gstack: changed Muse skill is restored" \
  "$(cat "$_gstack_home/.local/share/gstack-register/skills/gstack-qa/SKILL.md")" \
  "$(cat "$_gstack_home/.config/muse/skills/gstack-qa/SKILL.md")"

: >"$_gstack_muse_log"
rm -f "$_gstack_home/.config/muse/skills/gstack-qa/.gstack-register-managed"
printf 'hand-installed Muse skill\n' \
  >"$_gstack_home/.config/muse/skills/gstack-qa/SKILL.md"
touch -t 200001010000.00 "$_gstack_home/.cache/gstack-register/registration-v1"
_gstack_muse_warn_log=$(_tmpdir)/muse-warn.log
if gstack_register_sync >"$_gstack_muse_warn_log" 2>&1; then
  _pass "gstack: unmanaged Muse skill is preserved"
else
  _fail "gstack: unmanaged Muse skill is preserved"
fi
_assert_not_contains "gstack: unmanaged Muse skill is not reinstalled" \
  "skills install" "$(cat "$_gstack_muse_log")"
_assert_contains "gstack: unmanaged Muse skill warns" \
  "skipping unmanaged Muse skill" "$(cat "$_gstack_muse_warn_log")"
_assert_file_content "gstack: unmanaged Muse skill content is preserved" \
