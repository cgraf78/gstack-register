#!/usr/bin/env bash
# Characterize the imported Claude, Codex, Gemini, cache, and migration behavior.

# shellcheck disable=SC1090,SC1091,SC2034,SC2317

set -o pipefail
export NO_COLOR=1

repo_root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P) || exit 1
# shellcheck source=lib/test.sh
. "$repo_root/test/lib/test.sh"

REAL_HOME=$repo_root

_gstack_home=$(_tmpdir)
_gstack_repo="$_gstack_home/.local/share/garrytan/gstack"
mkdir -p "$_gstack_repo/bin" "$_gstack_repo/qa" "$_gstack_repo/review" \
  "$_gstack_repo/node_modules" "$_gstack_home/.codex" "$_gstack_home/.gemini"
cat >"$_gstack_repo/SKILL.md" <<'MD'
---
name: gstack
---
MD
cat >"$_gstack_repo/qa/SKILL.md" <<'MD'
---
name: qa
description: QA workflow: catches visual regressions. (gstack)
---

Run ~/.claude/skills/gstack/bin/gstack-config and keep .claude/skills/gstack vendored checks local.
MD
cat >"$_gstack_repo/review/SKILL.md" <<'MD'
---
name: review
---
MD
mkdir -p "$_gstack_repo/manual" "$_gstack_home/.claude/skills/manual"
cat >"$_gstack_repo/manual/SKILL.md" <<'MD'
---
name: manual
---
MD
cat >"$_gstack_home/.claude/skills/manual/SKILL.md" <<'MD'
---
name: manual-owned
---
MD
ln -s "$_gstack_repo" "$_gstack_home/.claude/skills/gstack"
ln -s gstack/open-gstack-browser "$_gstack_home/.claude/skills/connect-chrome"
ln -s gstack/checkpoint "$_gstack_home/.claude/skills/checkpoint"
mkdir -p "$_gstack_home/.codex/skills/qa" \
  "$_gstack_home/.codex/skills/review" \
  "$_gstack_home/.codex/skills/removed" \
  "$_gstack_home/.codex/skills/gstack-old"
cat >"$_gstack_home/.codex/skills/qa/SKILL.md" <<'MD'
---
name: qa
description: "old fixed gstack copy. (gstack)"
---

<!-- AUTO-GENERATED from SKILL.md.tmpl — do not edit directly -->

Run ~/.claude/skills/gstack/bin/gstack-update-check
MD
cat >"$_gstack_home/.codex/skills/review/SKILL.md" <<'MD'
---
name: review
description: "local review skill that mentions (gstack) in prose"
---
MD
cat >"$_gstack_home/.codex/skills/removed/SKILL.md" <<'MD'
---
name: removed
description: "old fixed gstack copy for a source skill that no longer exists"
---

<!-- AUTO-GENERATED from SKILL.md.tmpl — do not edit directly -->

Run ~/.claude/skills/gstack/bin/gstack-update-check
MD
touch "$_gstack_home/.codex/skills/gstack-old/.dotfiles-managed-gstack"
cat >"$_gstack_home/.codex/skills/gstack-old/SKILL.md" <<'MD'
---
name: gstack-old
---
MD
cat >"$_gstack_repo/node_modules/SKILL.md" <<'MD'
---
name: ignored
---
MD
cat >"$_gstack_repo/setup" <<'SH'
#!/usr/bin/env bash
printf 'setup %s\n' "$*" >>"$GSTACK_HOOK_LOG"
SH
cat >"$_gstack_repo/bin/gstack-uninstall" <<'SH'
#!/usr/bin/env bash
printf 'uninstall %s\n' "$*" >>"$GSTACK_HOOK_LOG"
SH
chmod +x "$_gstack_repo/setup" "$_gstack_repo/bin/gstack-uninstall"

_gstack_log=$(_tmpdir)/gstack.log
_gstack_muse_log=$(_tmpdir)/muse.log
: >"$_gstack_muse_log"
_gstack_agent_bin=$(_mock_bin)
cat >"$_gstack_agent_bin/codex" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat >"$_gstack_agent_bin/gemini" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat >"$_gstack_agent_bin/muse" <<'SH'
#!/usr/bin/env bash
# Mock Muse CLI: user-scope skills live under $HOME/.config/muse/skills.
skills_dir="$HOME/.config/muse/skills"
printf 'muse %s\n' "$*" >>"$GSTACK_MUSE_LOG"
[ "${1:-}" = "skills" ] || exit 0
case "${2:-}" in
  list)
    printf 'NAME\tSCOPE\tDESCRIPTION\tPATH\n'
    for skill_path in "$skills_dir"/gstack-*/; do
      [ -f "$skill_path/SKILL.md" ] || continue
      printf '%s\tuser\tmock\t%s/SKILL.md\n' \
        "$(basename "$skill_path")" "${skill_path%/}"
    done
    ;;
  install)
    src=''
    for arg in "$@"; do
      case "$arg" in
        --force | skills | install) continue ;;
        *) src=$arg ;;
      esac
    done
    [ -n "$src" ] && [ -d "$src" ] || exit 1
    name=$(basename "$src")
    mkdir -p "$skills_dir/$name"
    cp -r "$src/." "$skills_dir/$name/"
    ;;
  uninstall)
    id=${3:-}
    [ -n "$id" ] || exit 1
    rm -rf "$skills_dir/$id"
    ;;
esac
SH
chmod +x "$_gstack_agent_bin/codex" "$_gstack_agent_bin/gemini" \
  "$_gstack_agent_bin/muse"
_saved_home=$HOME
_saved_path=$PATH
HOME=$_gstack_home
PATH="$_gstack_agent_bin:$PATH"
export HOME PATH
export GSTACK_HOOK_LOG=$_gstack_log
export GSTACK_MUSE_LOG=$_gstack_muse_log

# shellcheck source=../lib/gstack-register/api.sh
. "$REAL_HOME/lib/gstack-register/api.sh"

if gstack_register_sync; then
  _pass "gstack: sync registers skills"
else
  _fail "gstack: sync registers skills"
fi
_assert_eq "gstack: sync does not run upstream setup" "" "$(cat "$_gstack_log" 2>/dev/null)"
_assert_file_missing "gstack: sync removes Claude compatibility root" \
