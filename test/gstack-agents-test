# Keep this fixture independent of host-installed commands with a restricted
# PATH, mirroring the Codex-only migration fixture above.
# ---------------------------------------------------------------------------
echo "=== gstack muse: missing CLI ==="
_gstack_muse_absent_home=$(_tmpdir)
_gstack_muse_absent_repo="$_gstack_muse_absent_home/.local/share/garrytan/gstack"
_gstack_muse_absent_bin=$(_mock_bin)
mkdir -p "$_gstack_muse_absent_repo/qa" \
  "$_gstack_muse_absent_home/.config/muse/skills/gstack-qa" \
  "$_gstack_muse_absent_home/.config/muse/skills/gstack-keep"
cat >"$_gstack_muse_absent_repo/SKILL.md" <<'MD'
---
name: gstack
---
MD
cat >"$_gstack_muse_absent_repo/qa/SKILL.md" <<'MD'
---
name: qa
---
MD
touch "$_gstack_muse_absent_home/.config/muse/skills/gstack-qa/.gstack-register-managed"
cat >"$_gstack_muse_absent_home/.config/muse/skills/gstack-qa/SKILL.md" <<'MD'
---
name: gstack-qa
---
MD
cat >"$_gstack_muse_absent_home/.config/muse/skills/gstack-keep/SKILL.md" <<'MD'
---
name: gstack-keep
---
MD
cat >"$_gstack_muse_absent_bin/codex" <<'SH'
#!/usr/bin/env bash
exit 0
SH
chmod +x "$_gstack_muse_absent_bin/codex"
_saved_home=$HOME
_saved_path=$PATH
HOME=$_gstack_muse_absent_home
PATH="$_gstack_muse_absent_bin:/usr/bin:/bin"
export HOME PATH

# shellcheck source=../lib/gstack-register/api.sh
. "$REAL_HOME/lib/gstack-register/api.sh"

if _gstack_register_has_agent muse; then
  _fail "gstack: Muse CLI is absent from the fixture PATH"
else
  _pass "gstack: Muse CLI is absent from the fixture PATH"
fi
if gstack_register_sync; then
  _pass "gstack: sync succeeds without the Muse CLI"
else
  _fail "gstack: sync succeeds without the Muse CLI"
fi
_assert_path_missing "gstack: missing Muse CLI removes managed Muse skill" \
  "$_gstack_muse_absent_home/.config/muse/skills/gstack-qa"
_assert_file_exists "gstack: missing Muse CLI preserves unmanaged Muse skill" \
  "$_gstack_muse_absent_home/.config/muse/skills/gstack-keep/SKILL.md"
_assert_file_exists "gstack: missing Muse CLI still links Codex skill" \
  "$_gstack_muse_absent_home/.codex/skills/gstack-qa/SKILL.md"

HOME=$_saved_home
PATH=$_saved_path
export HOME PATH
unset GSTACK_MUSE_LOG
unset -f gstack_register_source_dir gstack_register_migration_stamp \
  gstack_register_sync gstack_register_uninstall _gstack_register_warn \
  _gstack_register_log _gstack_register_has_agent _gstack_register_skill_name \
  _gstack_register_each_source_skill _gstack_register_load_source_skills \
  _gstack_register_reset_source_cache \
  _gstack_register_codex_skill_name _gstack_register_codex_skill_name_exists \
  _gstack_register_is_prefixed_skill_name _gstack_register_each_prefixed_skill_target \
  _gstack_register_remove_link_if_managed \
  _gstack_register_points_to_gstack _gstack_register_points_to_generated_skills \
  _gstack_register_points_to_managed_gstack _gstack_register_skill_dir_is_managed \
  _gstack_register_managed_marker _gstack_register_mark_managed_dir \
  _gstack_register_upstream_state_dir _gstack_register_generated_skills_dir \
  _gstack_register_opencode_generated_skills_dir _gstack_register_muse_skills_dir \
  _gstack_register_state_entry_is_known \
  _gstack_register_migrate_state_dir \
  _gstack_register_codex_root_is_managed _gstack_register_gemini_extension_is_managed \
  _gstack_register_legacy_codex_fixed_copy_is_gstack \
  _gstack_register_prune_stale_claude _gstack_register_prune_stale_codex \
  _gstack_register_prune_stale_gemini _gstack_register_prune_stale_muse \
  _gstack_register_prune_stale_generated_skills \
  _gstack_register_link_generated_skill _gstack_register_claude \
  _gstack_register_generated_skill_current _gstack_register_write_skill_md \
  _gstack_register_write_gemini_context _gstack_register_write_generated_skills \
  _gstack_register_remove_skill_link \
  _gstack_register_codex _gstack_register_gemini _gstack_register_muse \
  _gstack_register_muse_installed_skills _gstack_register_muse_skill_current \
