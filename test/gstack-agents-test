# ---------------------------------------------------------------------------
# gstack migration: the two non-destructive branches. The happy-path drain (and
# its whitelist invariant) is covered above; these guard the safety branches.
# Run the function in a fresh shell that sources only the migration units, so
# _dot_gstack_state_dir resolves from a controlled HOME.
# ---------------------------------------------------------------------------
echo "=== gstack migration: safety branches ==="
_gstack_mig_lib="$REAL_HOME/lib/gstack-register"
_run_gstack_migrate() { # $1=HOME  $2=expected-checkout arg
  HOME="$1" bash -c '
    . "$1/paths.sh"
    . "$1/migration.sh"
    _dot_gstack_migrate_state_dir "$2"
  ' _ "$_gstack_mig_lib" "$2" 2>&1
}

# Non-symlink ~/.gstack that already exists: leave its contents intact (the
# branch is a no-op besides ensuring the dir exists). "keep left intact" is the
# red-green assertion — a destructive rewrite of this branch loses it.
_gm_home=$(_tmpdir)
mkdir -p "$_gm_home/.gstack"
: >"$_gm_home/.gstack/keep"
_run_gstack_migrate "$_gm_home" "$(_tmpdir)" >/dev/null
_assert_file_exists "gstack migrate: existing non-symlink state dir is left intact" \
  "$_gm_home/.gstack/keep"

# Non-symlink ~/.gstack that is absent: the branch creates it as a real dir.
_gm_home_abs=$(_tmpdir)
rm -rf "$_gm_home_abs/.gstack"
_run_gstack_migrate "$_gm_home_abs" "$(_tmpdir)" >/dev/null
if [[ -d "$_gm_home_abs/.gstack" && ! -L "$_gm_home_abs/.gstack" ]]; then
  _pass "gstack migrate: absent state dir is created as a real directory"
else
  _fail "gstack migrate: absent state dir is created as a real directory"
fi

# ~/.gstack is a symlink to an UNEXPECTED target (not the managed checkout):
# refuse — warn and leave the symlink pointing exactly where it did, rather than
# replacing it with a real dir. (The drain source is the arg, not the symlink
# target, so the meaningful guard is that the symlink is left untouched.)
_gm_home2=$(_tmpdir)
_gm_elsewhere=$(_tmpdir)
ln -s "$_gm_elsewhere" "$_gm_home2/.gstack"
_gm_checkout2=$(_tmpdir) # the expected checkout, different from the symlink target
_gm_out=$(_run_gstack_migrate "$_gm_home2" "$_gm_checkout2")
if [[ -L "$_gm_home2/.gstack" ]]; then
  _pass "gstack migrate: unexpected symlink is not replaced"
else
  _fail "gstack migrate: unexpected symlink is not replaced"
fi
_assert_eq "gstack migrate: unexpected symlink still points to its original target" \
  "$_gm_elsewhere" "$(readlink "$_gm_home2/.gstack")"
_assert_contains "gstack migrate: warns on unexpected symlink target" "unexpected" "$_gm_out"

