#!/usr/bin/env bash
# Characterize the imported Claude, Codex, Gemini, cache, and migration behavior.

# shellcheck disable=SC1090,SC1091,SC2034,SC2317

set -o pipefail
export NO_COLOR=1

repo_root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P) || exit 1
# shellcheck source=lib/test.sh
. "$repo_root/test/lib/test.sh"

REAL_HOME=$repo_root

_gstack_hook="$REAL_HOME/test/legacy/gstack-shdeps-hook.sh"
_gstack_home=$(_tmpdir)
_gstack_repo="$_gstack_home/.local/share/garrytan/gstack"
mkdir -p "$_gstack_repo/bin" "$_gstack_repo/qa" "$_gstack_repo/review" \
  "$_gstack_repo/node_modules" "$_gstack_home/.codex" "$_gstack_home/.gemini"
cat >"$_gstack_repo/SKILL.md" <<'MD'
---
name: gstack
---
MD
cat >"$_gstack_repo/qa/SKILL.md" <<'MD'
---
name: qa
description: QA workflow: catches visual regressions. (gstack)
---

Run ~/.claude/skills/gstack/bin/gstack-config and keep .claude/skills/gstack vendored checks local.
MD
cat >"$_gstack_repo/review/SKILL.md" <<'MD'
---
name: review
---
MD
mkdir -p "$_gstack_repo/manual" "$_gstack_home/.claude/skills/manual"
cat >"$_gstack_repo/manual/SKILL.md" <<'MD'
---
name: manual
---
MD
cat >"$_gstack_home/.claude/skills/manual/SKILL.md" <<'MD'
---
name: manual-owned
---
MD
ln -s "$_gstack_repo" "$_gstack_home/.claude/skills/gstack"
ln -s gstack/open-gstack-browser "$_gstack_home/.claude/skills/connect-chrome"
ln -s gstack/checkpoint "$_gstack_home/.claude/skills/checkpoint"
mkdir -p "$_gstack_home/.codex/skills/qa" \
  "$_gstack_home/.codex/skills/review" \
  "$_gstack_home/.codex/skills/removed" \
  "$_gstack_home/.codex/skills/gstack-old"
cat >"$_gstack_home/.codex/skills/qa/SKILL.md" <<'MD'
---
name: qa
description: "old fixed gstack copy. (gstack)"
---

<!-- AUTO-GENERATED from SKILL.md.tmpl — do not edit directly -->

Run ~/.claude/skills/gstack/bin/gstack-update-check
MD
cat >"$_gstack_home/.codex/skills/review/SKILL.md" <<'MD'
---
name: review
description: "local review skill that mentions (gstack) in prose"
---
MD
cat >"$_gstack_home/.codex/skills/removed/SKILL.md" <<'MD'
---
name: removed
description: "old fixed gstack copy for a source skill that no longer exists"
---

<!-- AUTO-GENERATED from SKILL.md.tmpl — do not edit directly -->

Run ~/.claude/skills/gstack/bin/gstack-update-check
MD
touch "$_gstack_home/.codex/skills/gstack-old/.dotfiles-managed-gstack"
cat >"$_gstack_home/.codex/skills/gstack-old/SKILL.md" <<'MD'
---
name: gstack-old
---
MD
cat >"$_gstack_repo/node_modules/SKILL.md" <<'MD'
---
name: ignored
---
MD
cat >"$_gstack_repo/setup" <<'SH'
#!/usr/bin/env bash
printf 'setup %s\n' "$*" >>"$GSTACK_HOOK_LOG"
SH
cat >"$_gstack_repo/bin/gstack-uninstall" <<'SH'
#!/usr/bin/env bash
printf 'uninstall %s\n' "$*" >>"$GSTACK_HOOK_LOG"
SH
chmod +x "$_gstack_repo/setup" "$_gstack_repo/bin/gstack-uninstall"

_gstack_log=$(_tmpdir)/gstack.log
_gstack_agent_bin=$(_mock_bin)
cat >"$_gstack_agent_bin/codex" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat >"$_gstack_agent_bin/gemini" <<'SH'
#!/usr/bin/env bash
exit 0
SH
chmod +x "$_gstack_agent_bin/codex" "$_gstack_agent_bin/gemini"
_saved_home=$HOME
_saved_path=$PATH
HOME=$_gstack_home
PATH="$_gstack_agent_bin:$PATH"
export GSTACK_HOOK_LOG=$_gstack_log
export DOT_GSTACK_REGISTER_LIB="$REAL_HOME/lib/gstack-register/api.sh"
# shellcheck disable=SC2329  # sourced hook helper calls this by name.
shdeps_warn() { printf '%s\n' "$*" >&2; }

# shellcheck source=/dev/null
. "$_gstack_hook"

if post "garrytan/gstack"; then
  _pass "gstack: post hook registers skills"
else
  _fail "gstack: post hook registers skills"
fi
_assert_eq "gstack: post hook does not run upstream setup" "" "$(cat "$_gstack_log" 2>/dev/null)"
_assert_file_missing "gstack: post hook removes Claude compatibility root" \
  "$_gstack_home/.claude/skills/gstack/SKILL.md"
_assert_file_missing "gstack: post hook removes legacy Claude connect-chrome alias" \
  "$_gstack_home/.claude/skills/connect-chrome"
_assert_file_exists "gstack: post hook creates shared generated skill" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa/SKILL.md"
_assert_file_exists "gstack: post hook creates shared Gemini context" \
  "$_gstack_home/.gstack/dotfiles-skills/GEMINI.md"
_assert_file_exists "gstack: post hook marks shared generated skill as managed" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa/.dotfiles-managed-gstack"
_assert_file_exists "gstack: post hook links prefixed Claude skill" \
  "$_gstack_home/.claude/skills/gstack-qa/SKILL.md"
_assert_eq "gstack: post hook points Claude skill at shared generated skill" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa" \
  "$(readlink "$_gstack_home/.claude/skills/gstack-qa")"
_assert_file_missing "gstack: post hook removes legacy unprefixed Claude skill" \
  "$_gstack_home/.claude/skills/qa/SKILL.md"
_assert_contains "gstack: post hook preserves unmanaged Claude skill collision" \
  "name: manual-owned" "$(cat "$_gstack_home/.claude/skills/manual/SKILL.md")"
_assert_file_missing "gstack: post hook prunes stale Claude gstack link" \
  "$_gstack_home/.claude/skills/checkpoint"
_assert_file_missing "gstack: post hook prunes legacy unprefixed Codex copy" \
  "$_gstack_home/.codex/skills/qa/SKILL.md"
_assert_file_exists "gstack: post hook preserves unmanaged Codex skill with prose marker" \
  "$_gstack_home/.codex/skills/review/SKILL.md"
_assert_file_missing "gstack: post hook prunes removed-source legacy Codex copy" \
  "$_gstack_home/.codex/skills/removed/SKILL.md"
_assert_file_missing "gstack: post hook prunes stale managed Codex skill" \
  "$_gstack_home/.codex/skills/gstack-old/SKILL.md"
_assert_file_exists "gstack: post hook links Codex source skill" \
  "$_gstack_home/.codex/skills/gstack-qa/SKILL.md"
_assert_eq "gstack: post hook points Codex skill at shared generated skill" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa" \
  "$(readlink "$_gstack_home/.codex/skills/gstack-qa")"
_assert_file_exists "gstack: post hook marks Codex source skill as managed" \
  "$_gstack_home/.codex/skills/gstack-qa/.dotfiles-managed-gstack"
_assert_file_missing "gstack: post hook removes legacy Codex runtime root" \
  "$_gstack_home/.codex/skills/gstack/SKILL.md"
_assert_contains "gstack: post hook rewrites Codex skill name" \
  "name: gstack-qa" "$(cat "$_gstack_home/.codex/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: post hook quotes invalid Codex YAML descriptions" \
  'description: "QA workflow: catches visual regressions. (gstack)"' \
  "$(cat "$_gstack_home/.codex/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: post hook rewrites absolute Claude runtime paths" \
  "Run $_gstack_repo/bin/gstack-config" \
  "$(cat "$_gstack_home/.gstack/dotfiles-skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: post hook preserves project-relative vendored checks" \
  ".claude/skills/gstack vendored checks local" \
  "$(cat "$_gstack_home/.gstack/dotfiles-skills/gstack-qa/SKILL.md")"
_assert_file_exists "gstack: post hook creates Gemini extension manifest" \
  "$_gstack_home/.gemini/extensions/gstack/gemini-extension.json"
_assert_file_exists "gstack: post hook marks Gemini extension as managed" \
  "$_gstack_home/.gemini/extensions/gstack/.dotfiles-managed-gstack"
_assert_eq "gstack: post hook points Gemini context at shared generated context" \
  "$_gstack_home/.gstack/dotfiles-skills/GEMINI.md" \
  "$(readlink "$_gstack_home/.gemini/extensions/gstack/GEMINI.md")"
_assert_contains "gstack: generated Gemini context references prefixed skills" \
  "generated \`gstack-*\` agent" \
  "$(cat "$_gstack_home/.gstack/dotfiles-skills/GEMINI.md")"
# shellcheck disable=SC2088  # This assertion intentionally checks literal upstream prose.
_assert_not_contains "gstack: generated Gemini context avoids raw Claude runtime paths" \
  '~/.claude/skills/gstack' \
  "$(cat "$_gstack_home/.gstack/dotfiles-skills/GEMINI.md")"
_assert_file_exists "gstack: post hook links Gemini source skill" \
  "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa/SKILL.md"
_assert_eq "gstack: post hook points Gemini skill at shared generated skill" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa" \
  "$(readlink "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa")"
_assert_file_exists "gstack: post hook marks Gemini source skill as managed" \
  "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa/.dotfiles-managed-gstack"
_assert_contains "gstack: post hook rewrites Gemini skill name" \
  "name: gstack-qa" "$(cat "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: post hook quotes invalid Gemini YAML descriptions" \
  'description: "QA workflow: catches visual regressions. (gstack)"' \
  "$(cat "$_gstack_home/.gemini/extensions/gstack/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: post hook leaves upstream source skill unchanged" \
  "description: QA workflow: catches visual regressions. (gstack)" \
  "$(cat "$_gstack_repo/qa/SKILL.md")"
_assert_file_missing "gstack: post hook skips node_modules skills" \
  "$_gstack_home/.claude/skills/gstack-ignored/SKILL.md"
_assert_file_missing "gstack: post hook skips node_modules generated cache" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-ignored/SKILL.md"
_assert_file_exists "gstack: post hook stamps install-shape migration" \
  "$_gstack_home/.gstack/.dot-agent-agnostic-install-v1"
if [[ -d "$_gstack_home/.gstack" && ! -L "$_gstack_home/.gstack" ]]; then
  _pass "gstack: post hook uses real state directory"
else
  _fail "gstack: post hook uses real state directory"
fi

# Warm re-arming is a dot-convergence optimization. Load the same signal-safe
# resource owner that core dot uses before exercising its timestamp fence;
# standalone shdeps hook calls deliberately validate without creating an
# unowned temporary file.
# shellcheck source=legacy/cache-resources.sh disable=SC1091
. "$REAL_HOME/test/legacy/cache-resources.sh"

eval "$(declare -f _dot_gstack_register_claude |
  sed '1s/_dot_gstack_register_claude/_orig_dot_gstack_register_claude/')"
eval "$(declare -f _dot_gstack_register_codex |
  sed '1s/_dot_gstack_register_codex/_orig_dot_gstack_register_codex/')"
eval "$(declare -f _dot_gstack_register_gemini |
  sed '1s/_dot_gstack_register_gemini/_orig_dot_gstack_register_gemini/')"
eval "$(declare -f _dot_gstack_source_fingerprint |
  sed '1s/_dot_gstack_source_fingerprint/_orig_dot_gstack_source_fingerprint/')"
eval "$(declare -f _dot_gstack_target_fingerprint |
  sed '1s/_dot_gstack_target_fingerprint/_orig_dot_gstack_target_fingerprint/')"
_gstack_full_register_log=$(_tmpdir)/gstack-full-register.log
_gstack_fingerprint_log=$(_tmpdir)/gstack-fingerprint.log
_gstack_fingerprint_race_marker=$(_tmpdir)/gstack-fingerprint-race
: >"$_gstack_full_register_log"
: >"$_gstack_fingerprint_log"

_gstack_touch_newer_than() {
  local path="$1" reference="$2" deadline=$((SECONDS + 3))

  while [[ ! "$path" -nt "$reference" ]]; do
    touch "$path"
    [[ "$path" -nt "$reference" ]] && return 0
    ((SECONDS < deadline)) || return 1
    sleep 0.05
  done
}
# shellcheck disable=SC2329  # dot_gstack_register_all invokes this by name.
_dot_gstack_register_claude() {
  printf 'claude\n' >>"$_gstack_full_register_log"
  _orig_dot_gstack_register_claude "$@"
}
# shellcheck disable=SC2329  # dot_gstack_register_all invokes this by name.
_dot_gstack_register_codex() {
  printf 'codex\n' >>"$_gstack_full_register_log"
  _orig_dot_gstack_register_codex "$@"
}
# shellcheck disable=SC2329  # dot_gstack_register_all invokes this by name.
_dot_gstack_register_gemini() {
  printf 'gemini\n' >>"$_gstack_full_register_log"
  _orig_dot_gstack_register_gemini "$@"
}
# shellcheck disable=SC2329  # dot_gstack_register_all invokes this by name.
_dot_gstack_source_fingerprint() {
  local fence
  printf 'source\n' >>"$_gstack_fingerprint_log"
  if [[ -f "$_gstack_fingerprint_race_marker" ]]; then
    rm -f "$_gstack_fingerprint_race_marker"
    # The production code creates this validation-start fence immediately
    # before invoking the fingerprint. Move a watched parent strictly after it
    # to model a concurrent mutation without relying on clock resolution. The
    # glob deliberately mirrors cache.sh's allocator template; divergence fails
    # the later "forces one more proof" assertion rather than weakening it.
    for fence in "$_gstack_home/.gstack/.dotfiles-registration-cache-v1.rearm.tmp."*; do
      [[ -f "$fence" ]] || continue
      _gstack_touch_newer_than "$_gstack_home/.claude/skills" "$fence" || return 1
      break
    done
  fi
  _orig_dot_gstack_source_fingerprint "$@"
}
# shellcheck disable=SC2329  # dot_gstack_register_all invokes this by name.
_dot_gstack_target_fingerprint() {
  printf 'target\n' >>"$_gstack_fingerprint_log"
  _orig_dot_gstack_target_fingerprint "$@"
}

if dot_gstack_register_all; then
  _pass "gstack: current registration cache check succeeds"
else
  _fail "gstack: current registration cache check succeeds"
fi
_assert_eq "gstack: current registration skips full rewrite path" \
  "" "$(cat "$_gstack_full_register_log")"
_assert_eq "gstack: current registration skips fingerprint scans" \
  "" "$(cat "$_gstack_fingerprint_log")"

# A parent-directory mtime change can conservatively invalidate the watch fast
# path even when the source and every managed target are still byte-for-byte
# current. The first call must do the full fingerprint proof. Once that proof
# succeeds, the cache should be re-armed so every later warm update does not
# repeat the same expensive scan indefinitely.
if _gstack_touch_newer_than \
  "$_gstack_home/.claude/skills" \
  "$_gstack_home/.gstack/.dotfiles-registration-cache-v1"; then
  _pass "gstack: test invalidation is newer than the cache"
else
  _fail "gstack: test invalidation is newer than the cache"
fi
: >"$_gstack_full_register_log"
: >"$_gstack_fingerprint_log"
if dot_gstack_register_all; then
  _pass "gstack: unchanged parent mtime invalidation validates successfully"
else
  _fail "gstack: unchanged parent mtime invalidation validates successfully"
fi
_assert_eq "gstack: unchanged parent mtime does not rewrite registrations" \
  "" "$(cat "$_gstack_full_register_log")"
_assert_contains "gstack: unchanged parent mtime performs one fingerprint proof" \
  "source" "$(cat "$_gstack_fingerprint_log")"
: >"$_gstack_fingerprint_log"
if dot_gstack_register_all; then
  _pass "gstack: validated parent mtime re-arms the watch cache"
else
  _fail "gstack: validated parent mtime re-arms the watch cache"
fi
_assert_eq "gstack: re-armed watch cache skips repeated fingerprint scans" \
  "" "$(cat "$_gstack_fingerprint_log")"

# A mutation during fingerprint validation must not be hidden by re-arming the
# cache to a later completion timestamp. The next call must validate again;
# only that race-free proof may restore the watch fast path.
if _gstack_touch_newer_than \
  "$_gstack_home/.claude/skills" \
  "$_gstack_home/.gstack/.dotfiles-registration-cache-v1"; then
  _pass "gstack: race fixture starts with an invalidated cache"
else
  _fail "gstack: race fixture starts with an invalidated cache"
fi
: >"$_gstack_fingerprint_race_marker"
: >"$_gstack_fingerprint_log"
dot_gstack_register_all || _fail "gstack: concurrent invalidation validates successfully"
_assert_contains "gstack: concurrent invalidation performs fingerprint proof" \
  "source" "$(cat "$_gstack_fingerprint_log")"
: >"$_gstack_fingerprint_log"
dot_gstack_register_all || _fail "gstack: concurrent invalidation remains visible"
_assert_contains "gstack: concurrent invalidation forces one more proof" \
  "source" "$(cat "$_gstack_fingerprint_log")"
: >"$_gstack_fingerprint_log"
dot_gstack_register_all || _fail "gstack: race-free proof re-arms cache"
_assert_eq "gstack: race-free proof restores watch fast path" \
  "" "$(cat "$_gstack_fingerprint_log")"

# Interactive merge hooks execute the hook body in a nested Bash child. That
# child inherits the parent's registry variables but not its caught traps, so
# production must establish a child-owned cleanup context before allocating the
# fence. Verify that real execution shape still re-arms the parent-visible
# cache and leaves no sibling scratch behind.
if _gstack_touch_newer_than \
  "$_gstack_home/.claude/skills" \
  "$_gstack_home/.gstack/.dotfiles-registration-cache-v1"; then
  _pass "gstack: nested hook fixture starts with an invalidated cache"
else
  _fail "gstack: nested hook fixture starts with an invalidated cache"
fi
: >"$_gstack_fingerprint_log"
(dot_gstack_register_all) || _fail "gstack: nested hook validation succeeds"
_assert_contains "gstack: nested hook performs fingerprint proof" \
  "source" "$(cat "$_gstack_fingerprint_log")"
: >"$_gstack_fingerprint_log"
dot_gstack_register_all || _fail "gstack: nested hook re-arms cache"
_assert_eq "gstack: nested hook restores watch fast path" \
  "" "$(cat "$_gstack_fingerprint_log")"
_gstack_rearm_scratch=''
for _gstack_rearm_candidate in \
  "$_gstack_home/.gstack/.dotfiles-registration-cache-v1.rearm.tmp."*; do
  [[ -e "$_gstack_rearm_candidate" ]] || continue
  _gstack_rearm_scratch=$_gstack_rearm_candidate
  break
done
_assert_eq "gstack: nested hook removes re-arm scratch" "" "$_gstack_rearm_scratch"

ln -sfn "$_gstack_repo" "$_gstack_home/.claude/skills/gstack"
ln -sfn gstack/open-gstack-browser "$_gstack_home/.claude/skills/connect-chrome"
touch -r "$_gstack_home/.gstack/.dotfiles-registration-cache-v1" "$_gstack_home/.claude/skills"
: >"$_gstack_full_register_log"
if dot_gstack_register_all; then
  _pass "gstack: cache miss repairs recreated Claude compatibility roots"
else
  _fail "gstack: cache miss repairs recreated Claude compatibility roots"
fi
_assert_contains "gstack: recreated Claude root forces repair" \
  "claude" "$(cat "$_gstack_full_register_log")"
_assert_file_missing "gstack: cache miss removes recreated Claude compatibility root" \
  "$_gstack_home/.claude/skills/gstack"
_assert_file_missing "gstack: cache miss removes recreated connect-chrome alias" \
  "$_gstack_home/.claude/skills/connect-chrome"

touch -t 200001010000.00 "$_gstack_home/.gstack/.dotfiles-registration-cache-v1"
: >"$_gstack_full_register_log"
if dot_gstack_register_all; then
  _pass "gstack: target freshness check succeeds"
else
  _fail "gstack: target freshness check succeeds"
fi
_assert_contains "gstack: target newer than cache forces validation" \
  "codex" "$(cat "$_gstack_full_register_log")"

rm -f "$_gstack_home/.codex/skills/gstack-qa/SKILL.md"
: >"$_gstack_full_register_log"
if dot_gstack_register_all; then
  _pass "gstack: cache miss repairs missing generated skill"
else
  _fail "gstack: cache miss repairs missing generated skill"
fi
_assert_contains "gstack: missing generated skill forces Codex repair" \
  "codex" "$(cat "$_gstack_full_register_log")"
_assert_file_exists "gstack: cache miss restores missing generated skill" \
  "$_gstack_home/.codex/skills/gstack-qa/SKILL.md"

for i in {1..20}; do
  mkdir -p "$_gstack_home/.claude/skills/stale-$i" \
    "$_gstack_home/.codex/skills/gstack-stale-$i" \
    "$_gstack_home/.gemini/extensions/gstack/skills/gstack-stale-$i"
  touch "$_gstack_home/.claude/skills/stale-$i/.dotfiles-managed-gstack" \
    "$_gstack_home/.codex/skills/gstack-stale-$i/.dotfiles-managed-gstack" \
    "$_gstack_home/.gemini/extensions/gstack/skills/gstack-stale-$i/.dotfiles-managed-gstack"
  cat >"$_gstack_home/.claude/skills/stale-$i/SKILL.md" <<MD
---
name: stale-$i
---
MD
  cat >"$_gstack_home/.codex/skills/gstack-stale-$i/SKILL.md" <<MD
---
name: gstack-stale-$i
---
MD
  cat >"$_gstack_home/.gemini/extensions/gstack/skills/gstack-stale-$i/SKILL.md" <<MD
---
name: gstack-stale-$i
---
MD
done

eval "$(declare -f _dot_gstack_each_source_skill |
  sed '1s/_dot_gstack_each_source_skill/_orig_dot_gstack_each_source_skill/')"
_gstack_source_scan_log=$(_tmpdir)/gstack-source-scans.log
: >"$_gstack_source_scan_log"
: >"$_gstack_full_register_log"
_DOT_GSTACK_SOURCE_CACHE_DIR=''
# shellcheck disable=SC2329  # dot_gstack_register_all invokes this by name.
_dot_gstack_each_source_skill() {
  printf '.\n' >>"$_gstack_source_scan_log"
  _orig_dot_gstack_each_source_skill "$@"
}
if dot_gstack_register_all; then
  _pass "gstack: registration succeeds with stale managed skills"
else
  _fail "gstack: registration succeeds with stale managed skills"
fi
_assert_contains "gstack: stale managed skill bypasses cache" \
  "codex" "$(cat "$_gstack_full_register_log")"
_assert_file_missing "gstack: cache miss prunes stale managed Codex skill" \
  "$_gstack_home/.codex/skills/gstack-stale-1/SKILL.md"
_gstack_source_scan_count=$(wc -l <"$_gstack_source_scan_log" | tr -d ' ')
if [[ "$_gstack_source_scan_count" -le 10 ]]; then
  _pass "gstack: registration reuses source skill scan"
else
  _fail "gstack: registration reuses source skill scan (expected <= 10 scans, got $_gstack_source_scan_count)"
fi

: >"$_gstack_log"
if uninstall "garrytan/gstack"; then
  _pass "gstack: uninstall removes lightweight registrations"
else
  _fail "gstack: uninstall removes lightweight registrations"
fi
_assert_eq "gstack: uninstall does not call upstream cleanup" "" "$(cat "$_gstack_log")"
_assert_file_missing "gstack: uninstall removes Claude source skill" \
  "$_gstack_home/.claude/skills/gstack-qa/SKILL.md"
_assert_file_missing "gstack: uninstall removes Codex source skill" \
  "$_gstack_home/.codex/skills/gstack-qa/SKILL.md"
_assert_file_missing "gstack: uninstall removes Codex runtime root" \
  "$_gstack_home/.codex/skills/gstack"
_assert_file_missing "gstack: uninstall removes shared generated skill" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa/SKILL.md"
_assert_file_missing "gstack: uninstall removes shared Gemini context" \
  "$_gstack_home/.gstack/dotfiles-skills/GEMINI.md"

HOME=$_saved_home
PATH=$_saved_path
