#!/usr/bin/env bash
# Run each standalone behavior suite from the repository root.

set -u

repo_root=$(CDPATH='' cd "${BASH_SOURCE[0]%/*}/.." && pwd -P) || exit 1
status=0

for suite in \
  test/cli-test \
  test/gstack-cache-test \
  test/gstack-register-test \
  test/gstack-opencode-test \
  test/gstack-agents-test \
  test/gstack-provenance-test \
  test/install-test; do
  printf '=== %s ===\n' "${suite##*/}"
  (
    cd -P -- "$repo_root" || exit 1
    CDPATH=. "$suite"
  ) || status=1
done

if [[ "${GSTACK_REGISTER_SKIP_SHELLCHECK:-0}" != 1 ]] &&
  command -v shellcheck >/dev/null 2>&1; then
  # Local runs and shared CI read one typed inventory. A new sourced module
  # cannot silently miss one of the two lint paths.
  shell_files=()
  while IFS=$'\t' read -r record_type path ||
    [[ -n "$record_type$path" ]]; do
    [[ "$record_type" == program ]] || continue
    shell_files+=("$repo_root/$path")
  done <"$repo_root/.github/shellcheck-files.txt"

  if ((${#shell_files[@]} == 0)); then
    printf 'test/run: ShellCheck inventory has no programs\n' >&2
    status=1
  else
    (
      cd "$repo_root" || exit 1
      shellcheck -x -P SCRIPTDIR "${shell_files[@]}"
    ) || status=1
  fi
fi

exit "$status"
